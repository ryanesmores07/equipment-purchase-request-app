# Supabase Cloud project credentials.
# Copy this file to .env.local and fill in values from your Supabase project.
# Get URL and keys from Project Settings > API.
# Get the project ref from Project Settings > General.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_PROJECT_REF=<your-project-ref>

# Seeded reviewer users.
# These accounts are created by `pnpm db:seed-users`.
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee123!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Optional development helpers.
NEXT_PUBLIC_DEV_HELPERS=true
